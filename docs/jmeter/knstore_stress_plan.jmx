<JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert stock" enabled="true">
<stringProp name="scriptLanguage">groovy</stringProp>

<stringProp name="script">def j = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
if (j instanceof List &amp;&amp; j.size() &gt; 0) {
  def stock = j[0].inventario?.stock
  assert stock == 0 : &#x27;Se esperaba stock final 0 (15 vendidos), obtenido: &#x27; + stock
  log.info(&#x27;RNF-024: stock final &#x27; + stock + &#x27; con 30 hilos y stock inicial 15&#x27;)
} else { log.warn(&#x27;Producto F no encontrado&#x27;) }
prev.setSuccessful(true)</stringProp>
</JSR223Assertion>
