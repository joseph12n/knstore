# Plantilla de variables de entorno para producción (app-prod.yml).
# Copiar a .env en la EC2 y completar con valores reales. NUNCA commitear el .env.
SPRING_PROFILES_ACTIVE=prod

# Secreto JWT (base64). Generar uno propio, p. ej.:
#   openssl rand -base64 64 | tr -d '\n'
JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64_SECRET=

# MongoDB interno de Docker (replica set rs0 obligatorio para checkout transaccional)
SPRING_MONGODB_URI=mongodb://mongodb:27017/knstore?replicaSet=rs0&retryWrites=true&directConnection=true

# SMTP de Gmail (app password) para facturas y notificaciones
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_FROM=

# Administrador inicial (solo se usa si la base de datos esta vacia)
KNSTORE_SECURITY_ADMIN_LOGIN=admin
KNSTORE_SECURITY_ADMIN_PASSWORD=
KNSTORE_SECURITY_ADMIN_EMAIL=
