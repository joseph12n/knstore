          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert CP-063" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">def _r = prev.getResponseDataAsString()
assert prev.getResponseCode() == &apos;200&apos; : &apos;Codigo esperado 200, obtenido &apos; + prev.getResponseCode()
def j = new groovy.json.JsonSlurper().parseText(_r)
def b = { v -&gt; new BigDecimal(v == null ? &apos;0&apos; : v.toString()) }
def tot = b(j.total); def sub = b(j.subtotal); def iva = b(j.ivaTotal); def env = b(j.costoEnvio)
assert tot.compareTo(sub.add(iva).add(env)) == 0 : &apos;RF-048 total erróneo | body: &apos; + _r
assert env.compareTo(BigDecimal.ZERO) == 0 : &apos;RF-048 con subtotal &gt;= 150000 el envio debe ser gratis; costoEnvio=&apos; + j.costoEnvio + &apos; | body: &apos; + _r</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">false</stringProp>
          </JSR223Assertion>
