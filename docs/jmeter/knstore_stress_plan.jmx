<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
<hashTree>
<TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="KN-Store ESTRES y Rendimiento" enabled="true">
<stringProp name="TestPlan.comments">Plan de estres y rendimiento. Escenarios: catalogo, autenticacion, checkout, concurrencia (RNF-024) y soak. Cargas via -JN_S1..N_S5, ES_PAGE, S5_DUR.</stringProp>
<boolProp name="TestPlan.functional_mode">false</boolProp>
<boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
<elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
<collectionProp name="Arguments.arguments">
<elementProp name="PROTOCOL" elementType="Argument">
<stringProp name="Argument.name">PROTOCOL</stringProp>
<stringProp name="Argument.value">https</stringProp>
<stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="HOST" elementType="Argument">
<stringProp name="Argument.name">HOST</stringProp>
<stringProp name="Argument.value">app.knstore.duckdns.org</stringProp>
<stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="PORT" elementType="Argument">
<stringProp name="Argument.name">PORT</stringProp>
<stringProp name="Argument.value">443</stringProp>
<stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="ADMIN_USER" elementType="Argument">
<stringProp name="Argument.name">ADMIN_USER</stringProp>
<stringProp name="Argument.value">admin@knstore.com</stringProp>
<stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="ADMIN_PWD" elementType="Argument">
<stringProp name="Argument.name">ADMIN_PWD</stringProp>
<stringProp name="Argument.value">123456</stringProp>
<stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="CLI_USER" elementType="Argument">
<stringProp name="Argument.name">CLI_USER</stringProp>
<stringProp name="Argument.value">cliente01@knstore.com</stringProp>
<stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="CLI_PWD" elementType="Argument">
<stringProp name="Argument.name">CLI_PWD</stringProp>
<stringProp name="Argument.value">123456</stringProp>
<stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="ts" elementType="Argument">
<stringProp name="Argument.name">ts</stringProp>
<stringProp name="Argument.value">${__time(yyyyMMddHHmmss)}</stringProp>
<stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="N_S1" elementType="Argument">
<stringProp name="Argument.name">N_S1</stringProp>
<stringProp name="Argument.value">50</stringProp>
<stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="N_S2" elementType="Argument">
<stringProp name="Argument.name">N_S2</stringProp>
<stringProp name="Argument.value">40</stringProp>
<stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="N_S3" elementType="Argument">
<stringProp name="Argument.name">N_S3</stringProp>
<stringProp name="Argument.value">40</stringProp>
<stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="N_S4" elementType="Argument">
<stringProp name="Argument.name">N_S4</stringProp>
<stringProp name="Argument.value">50</stringProp>
<stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="N_S5" elementType="Argument">
<stringProp name="Argument.name">N_S5</stringProp>
<stringProp name="Argument.value">12</stringProp>
<stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="RAMPUP" elementType="Argument">
<stringProp name="Argument.name">RAMPUP</stringProp>
<stringProp name="Argument.value">10</stringProp>
<stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="S5_DUR" elementType="Argument">
<stringProp name="Argument.name">S5_DUR</stringProp>
<stringProp name="Argument.value">180</stringProp>
<stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="ES_PAGE" elementType="Argument">
<stringProp name="Argument.name">ES_PAGE</stringProp>
<stringProp name="Argument.value">0</stringProp>
<stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="N_S6" elementType="Argument">
<stringProp name="Argument.name">N_S6</stringProp>
<stringProp name="Argument.value">100</stringProp>
<stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="RAMP_S6" elementType="Argument">
<stringProp name="Argument.name">RAMP_S6</stringProp>
<stringProp name="Argument.value">2</stringProp>
<stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="N_S7" elementType="Argument">
