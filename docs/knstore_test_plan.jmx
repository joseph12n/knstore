            <stringProp name="script">def _r = prev.getResponseDataAsString()
assert prev.getResponseCode() == &apos;200&apos; : &apos;login &apos; + prev.getResponseCode()
def j = new groovy.json.JsonSlurper().parseText(_r)
vars.put(&apos;cliTok&apos;, j.id_token)
prev.setSuccessful(true)</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">false</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
