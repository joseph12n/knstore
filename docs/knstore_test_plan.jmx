          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert V-070" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">def _r = prev.getResponseDataAsString()
assert prev.getResponseCode() == &apos;200&apos; : &apos;Codigo esperado 200, obtenido &apos; + prev.getResponseCode()
def j = new groovy.json.JsonSlurper().parseText(_r)
assert j instanceof List &amp;&amp; j.size() &gt; 0 : &apos;Producto B no encontrado&apos;
def stock = j[0].inventario == null ? -1 : (j[0].inventario.stock as int)
assert stock &gt;= 0 : &apos;RNF-024 SI HUBO SOBREVENTA: stock final = &apos; + stock
log.info(&apos;RNF-024 stock final del producto B (stock inicial 2, 5 hilos): &apos; + stock)</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">false</stringProp>
          </JSR223Assertion>
