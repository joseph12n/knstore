<JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract admTok" enabled="true">
<stringProp name="scriptLanguage">groovy</stringProp>

<stringProp name="script">def _r = prev.getResponseDataAsString()
assert prev.getResponseCode() == &#x27;200&#x27; : &#x27;login &#x27; + prev.getResponseCode()
def j = new groovy.json.JsonSlurper().parseText(_r)
vars.put(&#x27;admTok&#x27;, j.id_token)
prev.setSuccessful(true)</stringProp>
</JSR223PostProcessor>
<hashTree/>
</hashTree>
