          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">def j = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
if (j &amp;&amp; j.size() &gt; 0) { props.setProperty(&apos;knstore.stress.dirId&apos;, j[0].id) } else { throw new RuntimeException(&apos;Sin direccion para el cliente; ejecutar la suite funcional CP-018/022 primero&apos;) }</stringProp>
            <stringProp name="parameters"></stringProp>
