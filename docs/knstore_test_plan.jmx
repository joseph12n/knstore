          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert CP-045" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">def _r = prev.getResponseDataAsString()
assert prev.getResponseCode() in [&apos;200&apos;,&apos;404&apos;] : &apos;Codigo esperado 200 (slug encontrado) o 404 (sin resultados activos), obtenido &apos; + prev.getResponseCode()
if (prev.getResponseCode() == &apos;200&apos;) { log.info(&apos;CP-045 slug consultado: &apos; + vars.get(&apos;searchSlug&apos;)) }
prev.setSuccessful(true)</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">false</stringProp>
          </JSR223Assertion>
