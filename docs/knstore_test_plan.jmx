          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract -&gt; seedCat" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
def j = new JsonSlurper().parseText(prev.getResponseDataAsString())
def l = j instanceof List ? j : null
vars.put(&apos;seedCatId&apos;, l ? (l.size() &gt; 0 ? l[0].id : &apos;NONE&apos;) : &apos;NONE&apos;)
vars.put(&apos;seedCatNombre&apos;, l ? (l.size() &gt; 0 ? l[0].nombre : &apos;NONE&apos;) : &apos;NONE&apos;)
</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">false</stringProp>
