<stringProp name="Argument.value">150</stringProp>
<stringProp name="Argument.metadata">=</stringProp>
</elementProp>
<elementProp name="RAMP_S7" elementType="Argument">
<stringProp name="Argument.name">RAMP_S7</stringProp>
<stringProp name="Argument.value">120</stringProp>
<stringProp name="Argument.metadata">=</stringProp>
</elementProp>
</collectionProp>
</elementProp>
