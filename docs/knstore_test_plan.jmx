          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert CP-077" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">def _r = prev.getResponseDataAsString()
assert prev.getResponseCode() == &apos;200&apos; : &apos;Codigo esperado 200, obtenido &apos; + prev.getResponseCode()
def fs = new groovy.json.JsonSlurper().parseText(_r)
def pagId = props.get(&apos;knstore.pagoId&apos;)
def f = fs.find { it.pago &amp;&amp; it.pago.id == pagId }
assert f != null : &apos;RF-066 no se encontro la factura del pago &apos; + pagId + &apos; (primeras: &apos; + fs.size() + &apos; facturas)&apos;
vars.put(&apos;facturaId&apos;, f.id)
props.setProperty(&apos;knstore.facturaId&apos;, f.id)</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">false</stringProp>
          </JSR223Assertion>
