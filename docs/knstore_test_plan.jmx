            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">def _r = prev.getResponseDataAsString()
assert prev.getResponseCode() == &apos;400&apos; : &apos;Código esperado 400, obtenido &apos; + prev.getResponseCode() + &apos; | body: &apos; + (_r.length()&gt;500? _r.substring(0,500) : _r)
assert _r.contains(&apos;already used&apos;) : &apos;La respuesta no contiene already used | body: &apos; + _r
prev.setSuccessful(true)
</stringProp>
