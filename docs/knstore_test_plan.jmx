          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert CP-009" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">def _r = prev.getResponseDataAsString()
assert prev.getResponseCode() == &apos;200&apos; : &apos;Código esperado 200, obtenido &apos; + prev.getResponseCode() + &apos; | body: &apos; + (_r.length()&gt;500? _r.substring(0,500) : _r)
prev.setSuccessful(true)
</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">false</stringProp>
          </JSR223Assertion>
