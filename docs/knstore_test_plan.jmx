            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">def _b = prev.getResponseDataAsString();assert prev.getResponseCode() == &apos;200&apos; : &apos;Código esperado 200, obtenido &apos; + prev.getResponseCode()</stringProp>
